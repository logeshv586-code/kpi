# Dev: VITE_API_URL=/api (Vite proxy → 127.0.0.1:8000)
# Production build: VITE_API_URL=/api (Nginx proxies /api → 127.0.0.1:8000)
#
# SERVER DEPLOY CHECKLIST:
# 1. Copy backend/ to server, configure backend/.env, run uvicorn on port 8000
# 2. npm run build, copy dist/ to Nginx web root
# 3. Use frontend/nginx.conf on the server (required for file uploads)
# 4. Open app at http://192.168.1.85/ (NOT :8000)
#
VITE_API_URL=/api
