# PostgreSQL (password special chars must be URL-encoded, e.g. @ → %40)
DATABASE_URL=postgresql+psycopg2://postgres:Admin%401234@192.168.1.85:5432/KPI
SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.85:5173,http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.85:8080
FRONTEND_URL=http://localhost:5173

# Company email gateway for KPI alerts.
# Put real values only in backend/.env or deployment secrets. Never commit passwords.
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=kpi-notifications@example.com
SMTP_PASSWORD=replace-with-smtp-or-app-password
SMTP_FROM=kpi-notifications@example.com
SMTP_FROM_NAME=KPI Performance Management
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
# For providers using implicit SSL on port 465, use SMTP_PORT=465,
# SMTP_USE_SSL=true and SMTP_USE_TLS=false.

KPI_MAX_UPLOAD_BYTES=10485760
# Use a writable absolute path on the server (required for file uploads).
KPI_UPLOAD_DIR=/var/kpi/uploads
KPI_SAMPLE_DIR=./samples
