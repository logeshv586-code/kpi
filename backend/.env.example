# Local development (use the Docker value from docker-compose.yml when running in Docker)
DATABASE_URL=postgresql+psycopg2://kpi:kpi_password@localhost:5432/kpi_db
SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.85:5173,http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.85:8080
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
KPI_MAX_UPLOAD_BYTES=10485760
KPI_UPLOAD_DIR=./uploads
KPI_SAMPLE_DIR=./samples
